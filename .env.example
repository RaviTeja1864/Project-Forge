# Copy to .env and replace the development secret before starting the app.
SECRET_KEY=replace-with-a-random-secret
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1,backend
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SESSION_COOKIE_SECURE=false
CSRF_COOKIE_SECURE=false
SECURE_SSL_REDIRECT=false
SECURE_HSTS_SECONDS=0
POSTGRES_DB=projectforge
POSTGRES_USER=projectforge
POSTGRES_PASSWORD=replace-with-a-strong-local-password
DB_HOST=localhost
DB_PORT=5432
VITE_API_BASE_URL=http://localhost:8000/api
# Required only to run the ReliefWeb ingestion command. Use an appname approved by ReliefWeb.
RELIEFWEB_APPNAME=
PROBLEM_SOURCE_HTTP_TIMEOUT=15
# Candidate threshold and result cap for transparent text similarity.
PROBLEM_SIMILARITY_THRESHOLD=0.35
PROBLEM_SIMILARITY_LIMIT=5
# Local Ollama only. For Compose, set a reachable host-gateway address and add that host to OLLAMA_ALLOWED_HOSTS.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_ALLOWED_HOSTS=localhost,127.0.0.1,::1
OLLAMA_MODEL=qwen3:4b
OLLAMA_CONNECT_TIMEOUT=3
OLLAMA_GENERATION_TIMEOUT=120
OLLAMA_MAX_OUTPUT_TOKENS=2048
RESEARCH_MAX_SOURCES=8
